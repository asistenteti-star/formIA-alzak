# Supabase — credenciales del proyecto
# Settings → API en el dashboard de Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo usado en el servidor (admin). Nunca se expone al cliente.
# Se llama "service_role" o "secret key" (formato sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# Token secreto para acceder a /admin/<TOKEN> (Fase 2)
# Genera uno largo, ej: openssl rand -hex 32
ADMIN_SECRET=
